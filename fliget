import configparser
def getconfig(custom_config):
    """
    Search for configurtion file if any. If not found, searches or
    removable media with label LIBRARY
    """
    default_path = "/media/" + os.environ["LOGNAME"]+"/LIBRARY"
    program="MultiLib1.11.200420U"
    config=configparser.ConfigParser(interpolation=None)
    config["archive"]={"path":default_path+"/Flibusta.Net",
                       "dbdump":program+".zip",
                       "dumpprefix":program+"/upload/flibusta/lib."}
    config["database"]={"driver":"sqlite",
                     "database":default_path+"/flibusta.db"}
    config["output"]={"path":"~/Books",
                      "name":'%A/%l_%n/%s/%N_%t',
                      "coauthor_links":"no"
                      }
    files=[os.path.expanduser("~/.config/flibusta/flibusta.conf")]
    if custom_config:
        files.append(custom_config)
    config.read(files)
    return config

def connect_db(config):
    """
    Connects to database, specified in the configuration file

    Uses config section  "database". Parameter 'driver' is name of
    database type. If driver == 'pgsql', tries psycopg and psycopg2
    modules. if driver =='sqlite' uses sqlite3 module. Otherwise
    expects value of this parameter to be a python module which provides
    connect functions returning DB-API 2.0 compatible handle.

    All other pararemeters in this section are passed to module connect
    function as keyword arguments.
    """
    modname=config["database"]["driver"]
    params=dict(config["database"])
    del params["driver"]
    if modname=="pgsql":
        try:
            module=__import__("psycopg")
        except ModuleNotFoundError:
            module=__import__("psycopg2")
        if "dbname" in params and "database" in params:
            del params["database"]
    else:
        if modname == "sqlite":
            modname="sqlite3"
            dbname=os.path.expanduser(config["database"]["database"])
            if not os.path.isdir(os.path.dirname(dbname)):
                os.makedirs(os.path.dirname(dbname))
            params["database"]=dbname
        module=__import__(modname)
    return module.connect(**params)

TABLES=["libavtor","libtranslator","libavtorname","libseq","libseqname",
        "libgenre","libgenrelist","libfilename","libbook"]
def initdb(conn):
    """
    If database doesn't have neccesary tables, create them
    """
    cur=conn.cursor()
    cur.execute("""CREATE TABLE libavtorname (
        AuthorId integer PRIMARY KEY,
        FirstName text,
        MiddleName text,
        LastName text,
        NickName text,
        uid bigint DEFAULT 0 NOT NULL,
        Email text,
        Homepage text,
        Gender character(1) DEFAULT '' NOT NULL,
        MasterId bigint DEFAULT 0 NOT NULL
        )""")
    cur.execute("""CREATE TABLE libbook (
            BookId integer PRIMARY KEY,
            FileSize  bigint DEFAULT 0 NOT NULL,
            Time timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
            Title text DEFAULT '' NOT NULL,
            Title1 text NOT NULL,
            Lang character(3) DEFAULT 'ru' NOT NULL,
            LangEx integer DEFAULT 0 NOT NULL,
            SrcLang character(3) DEFAULT '' NOT NULL,
            FileType character(4) NOT NULL,
            Encoding text DEFAULT '' NOT NULL,
            Year integer DEFAULT 0 NOT NULL,
            Deleted character(1) DEFAULT '0' NOT NULL,
            Ver text DEFAULT '' NOT NULL,
            FileAuthor text NOT NULL,
            N bigint DEFAULT 0 NOT NULL,
            keywords text NOT NULL,
            md5 text NOT NULL,
            Modified timestamp without time zone  NOT NULL,
            pmd5 character(32) DEFAULT '' NOT NULL,
            InfoCode smallint DEFAULT 0 NOT NULL,
            Pages numeric(10,0) DEFAULT 0 NOT NULL,
            Chars numeric(10,0) DEFAULT 0 NOT NULL
        )""")
    cur.execute("""CREATE TABLE libavtor (
        BookId integer DEFAULT 0,
        AuthorId integer DEFAULT 0,
        Pos smallint DEFAULT 0 NOT NULL,
        primary key (BookId, AuthorId)
        )""")
    cur.execute("""CREATE TABLE libfilename (
            BookId integer PRIMARY KEY,
            FileName text NOT NULL
        )""")
    cur.execute("""CREATE TABLE libgenrelist (
            GenreId integer PRIMARY KEY,
            GenreCode text DEFAULT '' UNIQUE NOT NULL,
            GenreDesc text DEFAULT '' NOT NULL,
            GenreMeta text DEFAULT '' NOT NULL
        )""")
    cur.execute("""CREATE TABLE libgenre (
            Id integer NOT NULL,
            BookId integer DEFAULT 0 NOT NULL,
            GenreId integer DEFAULT 0 NOT NULL,
            PRIMARY KEY (BookId,GenreId)
        )""")

    cur.execute("""CREATE TABLE libseqname (
        SeqId integer primary key,
        SeqName text DEFAULT '' NOT NULL
        )""")

    cur.execute("""CREATE TABLE libseq (
        BookId numeric(11,0) NOT NULL,
        SeqId numeric(11,0) NOT NULL,
        SeqNumb numeric(11,0) NOT NULL,
        Level smallint DEFAULT '0' NOT NULL,
