def cleardb(conn):
    """
    Removes all data from the database. It is neccessary 
    before reloading
    """
    if 'sqlite3' in globals():
        # We expect that only one database handling module ish
        # Sqlite 3 doesn't have TRUNCATE TABLE operator
        # but knows how to optimzis delete without where
        operator="DELETE FROM "
    else:
        operator="TRUNCATE TABLE "

    for table in TABLES:
        conn.execute(operator + table)
ESCAPES={"\\":"\\","'":"''",'"':'"','0':"","b":"","n":"","r":"","t":"\t",
"Z":"","%":"%","_":"_"}
def fix_escapes(line):
    """
    Replace MySQL-specific backslash escapes to
    SQL standard ones
    """
    ind=0
    while ind!=-1:
        ind=line.find("\\",ind)
        if ind == -1:
            break
        char=line[ind+1]
        tail=line[ind+2:]
        line=line[:ind]+ESCAPES.get(char,"")
        ind=len(line)
        line+=tail

def loaddb(conn, archive):
    """
    Extracts sql dumps from archive  and loads data into database

    """
    try:
        bookcount=conn.execute("select count(*) from libbook").fetchone()[0]
    except Exception: #pylint: disable=broad-exception-caught
        # We use broad exception because different drivers return
        # different one when table not found
        initdb(conn)
        bookcount=0
    if bookcount > 0:
        cleardb(conn)
    prefix=archive["dumpprefix"]
    conn.autocommit=True
    with zipfile.ZipFile(archive["dbdump"]) as zipf:
        for table in reversed(TABLES):
            print("Loading table "+table,file=sys.stderr)
            with zipf.open(prefix+table+".sql") as dumpfile:
                cursor = conn.cursor()
                for line in dumpfile:
                    if line.strip.startswith("INSERT INTO "+table):
                        # Fix MySQL-specific syntax in string constants
                        line=fix_escapes(line)
                        cursor.execute(line.rstrip(";"))

                        cursor.commit()

                cursor.close()
    print("data loading completed",file=sys.stderr)
def check_db(conn,conf):
    """
    Checks whether database contains same number of books as
    archive
    """
    try:
        books=conn.execute("select max(BookId) from libbook").fetchone()[0]
    except Exception: # pylint: disable=broad-exception-caught
        print("Database is not properly initialized. Execute "+sys.argv[0]+"==rebuild")
        sys.exit(1)
    booksarchive=0
    for file in glob.glob(conf["path"]+"/f.fb2-*-*-.zip"):
        _,_,finish=os.path.splitext(os.path.basename(file))[0].split("-")
        booksarchive=max(booksarchive,int(finish))
    if booksarchive != books:
        # pylint: disable=consider-using-f-string
        print("Database doesn't match archive. " +
              "Archive have %d books and database %d" % (booksarchive, books),
              file=sys.stderr)


def query_books(conn, where, params):
    """
    Perform query on books database, returns list of dicts
    """
    query = """SELECT libbook.bookid, title, title1, lang, filetype,
               lastname, firstname, middlename, nickname, seqnumb,seqname
               FROM libbook NATURAL JOIN libavtor USING bookid NATURAL JOIN
               libavtorname USING authorid LEFT OUTER JOIN libseq USING bookid
               NATURAL JOIN libseqname USING seqid WHERE deleted='0' AND"""
    query += where + " ORDER BY bookid, libavtor.pos"
    fields = ['bookid','title','title1','lang','filetype','lastname',
              'firstname','middlename','nickname','seqnum','seqname']
    cur = conn.cursor()
    for row in cur.execute(query, params):
        yield zip(fields,row)
    cur.close()

