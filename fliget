def getconfig(custom_config):
    """
    Search for configurtion file if any. If not found, searches or
    removable media with label LIBRARY
    """
    default_path = "/media/" + os.environ["LOGNAME"]+"/LIBRARY"
    program="MultiLib1.11.20040U"
    config=configparser.ConfigParser()
    config["archive"]={"path":default_path+"Flibusta.Net",
                       "dbdump":default_path+"Flibusta.Net/"+program+".zip",
                       "dumpprefix":program+"/upload/flibusta/lib."}
    config["database"]={"driver":"sqlite",
                     "database":default_path+"/flibusta.db"}
    config["output"]={"path":"~/Books",
                      "name":'%A/%a/%s/%N_%n.%t',
                      "coauthor_links":"no"
                      }
    files=[os.path.expanduser("~/.config/flibusta/flibusta.conf")]
    if custom_config:
        files.append(custom_config)
    config.read(files)
    return config

def connect_db(config):
    """
    Connects to database, specified in the configuration file

    Uses config section  "database". Parameter 'driver' is name of
    database type. If driver == 'pgsql', tries psycopg and psycopg2
    modules. if driver =='sqlite' uses sqlite3 module. Otherwise
    expects value of this parameter to be a python module which provides
    connect functions returning DB-API 2.0 compatible handle.

    All other pararemeters in this section are passed to module connect
    function as keyword arguments.
    """
    modname=config["database"]["driver"]
    params=dict(config["database"])
    del params["driver"]
    if modname=="pgsql":
        try:
            module=__import__("psycopg")
        except ModuleNotFoundError:
            module=__import__("psycopg2")
    else:
        if modname == "sqlite":
            modname="sqlite3"
            dbname=os.path.expanduser(config["database"]["database"])
            if not os.path.isdir(os.path.dirname(dbname)):
                os.makedirs(os.path.dirname(dbname))
            config["database"]["database"]=dbname
        module=__import__(modname)
    return module.connect(**config["database"])

