        )""")
    cur.execute("""CREATE TABLE libtranslator (
        BookId integer NOT NULL,
        TranslatorId integer NOT NULL,
        Pos smallint DEFAULT '0'  NOT NULL,
        primary key (BookId,TranslatorId))"""
    )
    # foreign keys
    # indexes
    cur.execute("CREATE INDEX booktitle ON libbook(title)")
    cur.execute("CREATE INDEX lnindex ON libavtorname(lastname)")
    cur.execute("CREATE INDEX fnindex ON libavtorname(firstname)")
    cur.execute("CREATE INDEX seqindex ON libseqname(seqname)")
    cur.close()
def cleardb(conn):
    """
    Removes all data from the database. It is neccessary 
    before reloading
    """
    if 'sqlite3' in sys.modules:
        # We expect that only one database handling module ish
        # Sqlite 3 doesn't have TRUNCATE TABLE operator
        # but knows how to optimzis delete without where
        operator="DELETE FROM "
    else:
        operator="TRUNCATE TABLE "
    cur=conn.cursor()
    for table in TABLES:
        cur.execute(operator + table)
    cur.close()    
ESCAPES={"\\":"\\","'":"''",'"':'"','0':"","b":"","n":"","r":"","t":"\t",
"Z":"","%":"%","_":"_"}
def fix_escapes(line):
    """
    Replace MySQL-specific backslash escapes to
    SQL standard ones
    """
    ind=0
    while ind!=-1:
        ind=line.find("\\",ind)
        if ind == -1:
            break
        char=line[ind+1]
        tail=line[ind+2:]
        line=line[:ind]+ESCAPES.get(char,"")
        ind=len(line)
        line+=tail
    return line

def loaddb(conn, archive):
    """
    Extracts sql dumps from archive  and loads data into database

    """
    conn.autocommit=True
    try:
        cur = conn.cursor()
        cur.execute("select count(*) from libbook")
        bookcount = cur.fetchone()[0]
        cur.close()
    except Exception as exch: #pylint: disable=broad-exception-caught
        print(repr(exch))
        # We use broad exception because different drivers return
        # different one when table not found
        initdb(conn)
        bookcount=0
    if bookcount > 0:
        cleardb(conn)
    prefix=archive["dumpprefix"]
    with zipfile.ZipFile(os.path.join(archive["path"],archive["dbdump"])) as zipf:
        for table in reversed(TABLES):
            print("Loading table "+table,file=sys.stderr)
            with zipf.open(prefix+table+".sql") as dumpfile:
                cursor = conn.cursor()
                for line in dumpfile:
                    line=line.decode('utf-8')
                    if line.strip().startswith("INSERT INTO "):
                        # Fix MySQL-specific syntax in string constants
                        line=fix_escapes(line).replace('`','')

                        cursor.execute(line.rstrip(";"))
                        conn.commit()

                cursor.close()
    print("data loading completed",file=sys.stderr)
def check_db(conn,conf):
    """
    Checks whether database contains same number of books as
    archive
    """
    try:
        cur=conn.cursor()
        cur.execute("select max(BookId) from libbook")
        books=cur.fetchone()[0]
        cur.close()
    except Exception: # pylint: disable=broad-exception-caught
        print("Database is not properly initialized. Execute "+sys.argv[0]+"==rebuild")
        sys.exit(1)
    booksarchive=0
    for file in glob.glob(conf["path"]+"/f.fb2-*-*.zip"):
        _,_,finish=os.path.splitext(os.path.basename(file))[0].split("-")
        booksarchive=max(booksarchive,int(finish))
    if booksarchive != books:
        # pylint: disable=consider-using-f-string
        print("Database doesn't match archive. " +
              "Archive have %d books and database %d" % (booksarchive, books),
              file=sys.stderr)

def display(book,secondary):
    """
    Prints information about found book
    """
    if secondary:
        return
    print("%7d|%-24s|%-40s"%(book["bookid"],
       book["lastname"]+ (" "+book["firstname"] if book["firstname"] else ""),
       book["title"]),end="")
    if book["seqname"]:
        print("|"+book["seqname"]+" -",book["seqnum"],end="")
    print("")


def condition(field,value,exact):
    """
    Prepares sql operator with question mark depending
    on exactnes flag
    """
    if exact:
        return  field + " = " + sqlquote(value)
    return  field + " like " + sqlquote(value+"%")

def sqlquote(string):
    """
    Makes string safe to embed into query
    """
    return "'"+string.replace("'","''")+"'"


def name2query(name, exact):
    """
    Converts author or translator  name to query 
    Expects up to three space separated fields 
    lastname firstname middlename
    """
    result=[]
    for field, value in zip(['lastname','firstname','middlename'],
                            (name.split()+[None,None,None])[:3]):
        if value is not None:
            result.append(condition(field,value,exact))
    return " AND ".join(result)
def search_query(options):
    """
    Convert set of parsed command-line options to SQL expression
    """
    conditions=[]
    if not options.deleted:
        conditions.append("libbook.deleted = '0'")
    if options.author:
        conditions.append(name2query(options.author,options.exact))
    if options.name:
        conditions.append("("+condition("title",options.name,options.exact)+
                          " OR " +
                          condition("seqname",options.name,options.exact)+")")
    if options.title:
        conditions.append(condition("title",options.title, options.exact))
    if options.sequence:
        conditions.append(condition("seqname",options.sequence,options.exact))
    if options.genre:
        conditions.append("genrecode = " +sqlquote(options.genre))
    return " AND ".join(conditions)
def query_books(conn, where):
    """
    Perform query on books database, returns list of dicts
    """
    query = """SELECT libbook.bookid, title, title1, lang, filetype,
               lastname, firstname, middlename, nickname, seqnumb,seqname
               FROM libbook JOIN libavtor USING (bookid) JOIN
               libavtorname USING (authorid)
               JOIN libgenre USING (bookid) JOIN libgenrelist USING (genreid)
               LEFT OUTER JOIN libseq USING (bookid)
               JOIN libseqname USING (seqid) WHERE """
    query += where + " ORDER BY bookid, libavtor.pos"
    fields = ['bookid','title','title1','lang','filetype','lastname',
              'firstname','middlename','nickname','seqnum','seqname']
    if "DEBUG" in os.environ:
        print(query)
    cur = conn.cursor()
    cur.execute(query)
    for row in cur:
        yield dict(zip(fields,row))
    cur.close()

FIELDS={'n':'firstname','l':'lastname','m':'middlename','t':'title','A':'A',
        's':'seqname', 'N':'seqnum','i':'bookid','L':'lang'}

BADCHARS=str.maketrans("\"':\n\r\t ;","_"*8)

def construct_name(book_id, conn, template):
    """
    Constructs name of output file based on metainformation 
    from database. Returns pair of constructed name and file type
    """
    template = os.path.expanduser(template)
    bookinfo = next(query_books(conn, "bookid=%d" % book_id))
    bookinfo['A']=bookinfo["lastname"][0]
    ind = 0
    start=0
    name=""
    while ind != -1:
        ind=template.find("%",start)
        if ind == -1:
            name += template[start:]
            break
        name += template[start:ind]
        key = template[ind+1]
        if key == "%":
            name+=key
        elif key in FIELDS:
            value = bookinfo[FIELDS[key]]
            if value is  None:
                value=''
            name+=str(value)
            start=ind+2
        else:
            raise ValueError("Invalid format specifier "+ key)
    name = name.translate(BADCHARS)
    while '__' in name:
        name = name.replace("__","_")
    return name.replace('/_','/').replace('//','/').replace("/...","/…"), bookinfo["filetype"]
def extract(conn,conf,book_id):
    """
    Exracts from archives into output directory described in the config
    """
    outpath=os.path.expanduser(conf["output"]["path"])
    name, btype = construct_name(book_id, conn,
            os.path.join(outpath,conf["output"]["name"]))
    if 'DEBUG' in os.environ:
        print(f"extract {book_id}.{btype} to {name}")
    for archive in glob.glob(conf["archive"]["path"]+"/*-*-*.zip"):
        if archive.startswith("d."):
            continue
        (ftype,start,finish)=os.path.basename(archive)[:-4].replace("--","-").split("-")
        if ftype.startswith("f."):
            ftype=ftype[2:]
        if int(start) <= book_id <= int(finish) and (
            ftype == ("fb2" if btype == "fb2" else "usr")):
            with zipfile.ZipFile(archive) as zipf:
                directory=os.path.dirname(name)
                if not os.path.isdir(directory):
                    os.makedirs(directory)
                if not os.path.exists(outpath+"/zip") or btype != "fb2":
                    zipf.extract(str(book_id)+"."+btype, path=name)
                else:
                    with zipfile.ZipFile(name+".fb2.zip", "w") as outfile:
                        outfile.writestr(name+".fb2",zipf.read(str(book_id)+".fb2"))

def parse_options():
    """
    Parses options and returns dict of options and
    list of args
    """
    parser=optparse.OptionParser(
        "Usage: %prog [options] or %prog --rebuild or %prog --get numbers..."
        )
    parser.add_option("-r", "--rebuild", dest="rebuild", default=False,
            action="store_true",
            help="Rebuild the database from dumps in the archive")
    parser.add_option("-g", "--get", dest="get", default=False,
            action="store_true",
            help="Extract files from archve instead of just printing info")
    parser.add_option("-l", "--list", dest="list", default=None,
            help="List genres or authors matching arg")
    parser.add_option("-n", "--name", dest="name", default=None,
            help="Search given pattern in title or sequence name of book")
    parser.add_option("-a","--author",dest="author",default=None,
            help="Search given pattern in the author name. Author should be" +
            "given as LastName FirstName Midllename separated by spaces")
    parser.add_option("-t","--title",dest="title",default=None,
        help="Search only title")
    parser.add_option("-s","--sequence",dest="sequence",default=None,
        help="Search given pattern only in sequence name")
    parser.add_option("-G","--genre",dest="genre",default=None,
        help="Search for genre")
    parser.add_option("-d","--deleted",dest="deleted",default=False,
               action="store_true",
               help="include deleted books in search results")
    parser.add_option("-x","--exact",dest="exact",default=False,
        action="store_true",
        help="Search by exact comparation, not using SQL LIKE operator")
    parser.add_option("-c","--config",dest="config",
    default=os.path.expanduser("~/.config/fliget.conf"),
    help="Alternate configuratiion file")
    return parser.parse_args()

def list_genres(conn,pattern):
    """
    Print list of genres matching pattern
    """
    query = "SELECT GenreCode, GenreDesc From libgenrelist"
    if pattern:
        query += " WHERE genrecode LIKE "+sqlquote('%'+pattern+'%')
    if "DEBUG" in os.environ:
        print(query)
    cur=conn.cursor()
    cur.execute(query)
    for code,desc in cur:
        print("%-24s|%s" % (code,desc))
    cur.close()

def list_authors(conn,template,exact):
    """
    Makes list of authors
    """
    query = "SELECT lastname, firstname, middlename, nickname FROM libavtorname WHERE "
    query += name2query(template,exact)
    query += " ORDER BY lastname, firstname, middlename"
    if "DEBUG" in os.environ:
        print(query)
    cur=conn.cursor()
    cur.execute(query)
    for last,first,middle,nick in cur:
        print(last,first,middle,nick)
def main():
    """
    Glue it all together
    """
    options, args = parse_options()
    config=getconfig(options.config)
    conn=connect_db(config)
    if options.rebuild:
        loaddb(conn, config["archive"])
        return 0
    check_db(conn, config["archive"])
    if options.list:
        if options.list.startswith('g'):
            list_genres(conn,args[0] if args else None)
            return 0
        if options.list.startswith('a'):
            if not args:
                raise ValueError("There are to many authors specify search pattern")
            list_authors(conn,args[0],options.exact)
            return 0
        raise ValueError("Invalid value %s for -l option" % options.list)
    if options.get and args:
        for book_id in args:
            extract(conn,config, int(book_id))
        return 0
    where = search_query(options)

    seen=set()
    for book in query_books(conn,where):
        if options.get:
            if book["bookid"] not in seen:
                extract(conn, config, book.bookid)
        else:
            display(book, book["bookid"] in seen)
        seen.add(book["bookid"])
    return 0

if __name__ == "__main__":
    try:
        main()
    except Exception as e: #pylint: disable=broad-exception-caught
        if "DEBUG" in os.environ:
            raise e
        print(str(e), file=sys.stderr)
        sys.exit(1)
